    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#belongsToCuisine -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#belongsToCuisine">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Dish"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Cuisine"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#hasIngredient -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#hasIngredient">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Dish"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Ingredient"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#hasTypicalIngredient -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#hasTypicalIngredient">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Cuisine"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Ingredient"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#isIngredientOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#isIngredientOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Ingredient"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Dish"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#originatesFrom -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#originatesFrom">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Cuisine"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Place"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#hasConfidence -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#hasConfidence">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#hasDescription -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#hasDescription">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Dish"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#hasName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#hasName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Cuisine"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Dish"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Ingredient"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


