    <!-- http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#EuropeanCuisine -->

    <owl:Class rdf:about="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#EuropeanCuisine">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Dish"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#hasIngredient"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#DairyProduct"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Cuisine"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Fruit -->

