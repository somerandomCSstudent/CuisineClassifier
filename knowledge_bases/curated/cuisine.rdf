    <!-- http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Dish -->

    <owl:Class rdf:about="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Dish"/>
    


    <!-- http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#EggProduct -->

    <owl:Class rdf:about="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#EggProduct">
