    </owl:Class>
    


    <!-- http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Cuisine -->

    <owl:Class rdf:about="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Cuisine">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Dish"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Ingredient"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#Place"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#DairyContainingDish -->

    <owl:Class rdf:about="http://www.semanticweb.org/peter/ontologies/2026/10/untitled-ontology-25#DairyContainingDish">
